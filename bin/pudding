#!/usr/bin/env python3
"""
pudding: Ultra-fast, zero-dependency natural language shell bridge.
Supports DeepSeek, OpenAI (ChatGPT), Ollama, Groq, and any OpenAI-compatible endpoint.
"""

import sys
import os
import re
import json
import subprocess
import urllib.request
import urllib.error

DEFAULT_CONFIG_PATH = os.path.expanduser("~/.config/pudding/config.json")
LEGACY_CONFIG_PATH = os.path.expanduser("~/.config/ai-sh/config.json")
DEEPSEEK_KEY_FILE = os.path.expanduser("~/.deepseek_key")

def is_placeholder_key(key):
    if not key or not isinstance(key, str):
        return True
    k = key.lower()
    return "tu-api-key" in k or "your-" in k or "example" in k or k.startswith("sk-tu-") or k.startswith("sk-your-")

def load_config():
    # 1. Base defaults
    config = {
        "api_url": "https://api.deepseek.com/v1/chat/completions",
        "model": "deepseek-chat",
        "api_key": ""
    }

    # 2. Config file (lowest priority, placeholder keys are ignored)
    for p in [DEFAULT_CONFIG_PATH, LEGACY_CONFIG_PATH]:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
                    for k, v in cfg.items():
                        if k == "api_key":
                            if v and not is_placeholder_key(v):
                                config["api_key"] = v
                        elif v:
                            config[k] = v
                    break
            except Exception:
                pass

    # 3. Dedicated environment variables (override config file)
    if os.environ.get("PUDDING_API_BASE"):
        config["api_url"] = os.environ.get("PUDDING_API_BASE")
    if os.environ.get("PUDDING_MODEL"):
        config["model"] = os.environ.get("PUDDING_MODEL")
    if os.environ.get("PUDDING_API_KEY") and not is_placeholder_key(os.environ.get("PUDDING_API_KEY")):
        config["api_key"] = os.environ.get("PUDDING_API_KEY")

    # 4. DeepSeek key from env
    if not config["api_key"] and os.environ.get("DEEPSEEK_API_KEY") and not is_placeholder_key(os.environ.get("DEEPSEEK_API_KEY")):
        config["api_key"] = os.environ.get("DEEPSEEK_API_KEY")
        if "deepseek" not in config["api_url"]:
            config["api_url"] = "https://api.deepseek.com/v1/chat/completions"
            config["model"] = "deepseek-chat"

    # 5. Key file ~/.deepseek_key
    if not config["api_key"] and os.path.exists(DEEPSEEK_KEY_FILE):
        try:
            with open(DEEPSEEK_KEY_FILE, "r", encoding="utf-8") as f:
                k = f.read().strip()
                if k and not is_placeholder_key(k):
                    config["api_key"] = k
                    if "deepseek" not in config["api_url"]:
                        config["api_url"] = "https://api.deepseek.com/v1/chat/completions"
                        config["model"] = "deepseek-chat"
        except Exception:
            pass

    # 6. OpenAI key from env
    if not config["api_key"] and os.environ.get("OPENAI_API_KEY") and os.environ.get("OPENAI_API_KEY") != "ollama-local" and not is_placeholder_key(os.environ.get("OPENAI_API_KEY")):
        config["api_key"] = os.environ.get("OPENAI_API_KEY")
        if "openai" not in config["api_url"]:
            config["api_url"] = "https://api.openai.com/v1/chat/completions"
            config["model"] = "gpt-4o-mini"

    return config

CONFIG = load_config()

def call_api(messages, max_tokens=250, temperature=0.0):
    is_local = any(h in CONFIG["api_url"] for h in ["localhost", "127.0.0.1", "0.0.0.0"])
    if not CONFIG["api_key"] and not is_local:
        return "NONE"

    payload = {
        "model": CONFIG["model"],
        "messages": messages,
        "temperature": temperature,
        "max_tokens": max_tokens
    }
    
    headers = {
        "Content-Type": "application/json",
        "User-Agent": "pudding/1.0"
    }
    if CONFIG["api_key"]:
        headers["Authorization"] = f"Bearer {CONFIG['api_key']}"

    req = urllib.request.Request(
        CONFIG["api_url"],
        data=json.dumps(payload).encode("utf-8"),
        headers=headers
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        return data["choices"][0]["message"].get("content", "").strip()

def get_quick_sys_metrics():
    """Gathers real-time memory and disk metrics in <5ms."""
    parts = []
    # macOS Memory
    try:
        total_bytes = int(subprocess.check_output(['sysctl', '-n', 'hw.memsize']).decode().strip())
        total_ram = round(total_bytes / (1024**3), 1)
        vm = subprocess.check_output(['vm_stat']).decode()
        page_match = re.search(r'page size of (\d+) bytes', vm)
        page_size = int(page_match.group(1)) if page_match else 16384
        stats = {}
        for line in vm.splitlines():
            m = re.match(r'Pages (\w+[^:]*):\s+(\d+)\.', line.strip())
            if m:
                stats[m.group(1).strip()] = int(m.group(2))
        avail_bytes = (stats.get('free', 0) + stats.get('inactive', 0) + stats.get('speculative', 0) + stats.get('purgeable', 0)) * page_size
        avail_ram = round(avail_bytes / (1024**3), 1)
        used_ram = round(total_ram - avail_ram, 1)
        parts.append(f"RAM_TOTAL: {total_ram} GB | RAM_DISPONIBLE: {avail_ram} GB | RAM_EN_USO: {used_ram} GB")
    except Exception:
        pass

    # Disk
    try:
        df = subprocess.check_output(['df', '-h', '/']).decode().splitlines()[1].split()
        parts.append(f"DISCO_TOTAL: {df[1]} | DISCO_DISPONIBLE: {df[3]} | DISCO_USADO_PCT: {df[4]}")
    except Exception:
        pass

    return "\n".join(parts)

SESSION_ID = os.environ.get("PUDDING_SESSION_ID", str(os.getppid()))
HIST_FILE = f"/tmp/.pudding_hist_{SESSION_ID}"

def get_recent_history(max_entries=4):
    if not os.path.exists(HIST_FILE):
        return ""
    try:
        with open(HIST_FILE, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]
        recent = lines[-max_entries:]
        return "\n".join(f"- {l}" for l in recent) if recent else ""
    except Exception:
        return ""

def append_history(query, response_summary):
    try:
        lines = []
        if os.path.exists(HIST_FILE):
            with open(HIST_FILE, "r", encoding="utf-8") as f:
                lines = [line.strip() for line in f if line.strip()]
        lines.append(f"User: {query} -> {response_summary}")
        lines = lines[-10:]
        with open(HIST_FILE, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    except Exception:
        pass

def extract_json_payload(text):
    if not text:
        return None
    text = text.strip()
    try:
        return json.loads(text)
    except Exception:
        pass
    m = re.search(r'```(?:json)?\s*(\{.*?\})\s*```', text, re.DOTALL)
    if m:
        try:
            return json.loads(m.group(1))
        except Exception:
            pass
    start = text.find('{')
    end = text.rfind('}')
    if start != -1 and end > start:
        try:
            return json.loads(text[start:end+1])
        except Exception:
            pass
    return None

INTENT_PROMPT = """You are an expert Unix/macOS developer terminal engine.
Your role is to translate developer intent into autonomous, robust shell commands or provide cold, analytical, concise system insights.

You have full environmental telemetry:
- Working Directory (CWD)
- Directory Contents (visible folders/files)
- Recent Session History (prior user actions in this shell)

CLASSIFY AND FORMAT USER REQUESTS:
1. "action": An executable terminal command is required to autonomously fulfill the user objective.
   ENGINEERING REQUIREMENTS FOR COMMANDS:
   - Autonomous & Self-Sufficient: Commands must succeed without interactive prompts (use -p for mkdir, -y for package managers where applicable).
   - Defensive Chaining: Chain sequential dependencies using "&&" so failure in step 1 halts subsequent execution.
   - Path Quoting: Always quote variables and paths containing spaces or potential special characters ("$TARGET", "$HOME/...").
   - Telemetry Utilization: If user references a local file (e.g. "compila el cpp"), look at Directory Contents to extract the exact filename.
   - macOS Native: For searching files/apps, use Spotlight `mdfind` (e.g. `mdfind -name "<core_stem>"`). NEVER use recursive root `find /`.
   - Find & Enter: When user asks to find and enter ("busca x y entra"), resolve the path and cd:
     TARGET=$(mdfind -name "<core_stem>" 2>/dev/null | head -1); [ -n "$TARGET" ] && cd "$([ -d "$TARGET" ] && echo "$TARGET" || dirname "$TARGET")" && pwd || echo "No encontrado"
   Output format: {"type": "action", "cmd": "<command>"}

2. "info": Inquiries regarding live system telemetry (RAM, disk, CPU, ports, network, hardware):
   - Memory & Disk: "SPECIAL_SYS_METRICS"
   - CPU / Top Consumers: "ps -eo %cpu,comm | sort -k1 -rn | head -8"
   - IP / Network Interfaces: "ifconfig en0 | grep \"inet \"; curl -s --max-time 2 ifconfig.me 2>/dev/null"
   - Open TCP Ports: "lsof -iTCP -sTCP:LISTEN -P -n"
   Output format: {"type": "info", "inspect_cmd": "<command>"}

3. "explain": Conversational inquiry, technical question, troubleshooting, or verification of an asset that DOES NOT exist based on Telemetry:
   - Pragmatic, analytical, cold tone. Zero conversational filler, zero politeness rituals, zero emojis, zero markdown bold/asterisks.
   - State facts directly in 1-2 lines.
   Output format: {"type": "explain", "answer": "<concise analytical answer>"}

Output strictly valid raw JSON.
"""

def handle_query(query):
    clean_query = query.strip("'\" \t\r\n")
    if not clean_query:
        print("NONE")
        return

    cwd = os.getcwd()
    try:
        items = os.listdir(cwd)
        dirs = [f"{d}/" for d in items if os.path.isdir(os.path.join(cwd, d)) and not d.startswith(".")]
        files = [f for f in items if os.path.isfile(os.path.join(cwd, d)) and not f.startswith(".")]
        parts = []
        if dirs:
            parts.append("Dirs: " + ", ".join(dirs[:12]))
        if files:
            parts.append("Files: " + ", ".join(files[:12]))
        dir_summary = " | ".join(parts) if parts else "(empty or hidden)"
    except Exception:
        dir_summary = "(inaccessible)"

    recent_hist = get_recent_history()
    
    user_msg_parts = [f"Current working directory: {cwd}"]
    user_msg_parts.append(f"Directory contents: {dir_summary}")
    if recent_hist:
        user_msg_parts.append(f"Recent session history:\n{recent_hist}")
    user_msg_parts.append(f"User request: {clean_query}")
    
    user_msg = "\n".join(user_msg_parts)
    
    try:
        raw_res = call_api([
            {"role": "system", "content": INTENT_PROMPT},
            {"role": "user", "content": user_msg}
        ], max_tokens=250)
        
        parsed = extract_json_payload(raw_res)
        if not parsed:
            raise ValueError("Invalid JSON response")

        q_type = parsed.get("type", "none")
        
        if q_type == "action":
            cmd = parsed.get("cmd", "").strip()
            if cmd.startswith("$ ") or cmd.startswith("# "):
                cmd = cmd[2:].strip()
            append_history(clean_query, f"Action: {cmd}")
            print(f"ACTION:{cmd}")
            return

        elif q_type == "explain":
            ans = parsed.get("answer", "").strip()
            ans = re.sub(r'[*`_#]', '', ans).strip()
            append_history(clean_query, f"Answer: {ans}")
            print(f"INFO:{ans}")
            return
            
        elif q_type == "info":
            append_history(clean_query, "Info query")
            inspect_cmd = parsed.get("inspect_cmd", "").strip()
            if inspect_cmd == "SPECIAL_SYS_METRICS" or any(w in clean_query.lower() for w in ["memoria", "ram", "disco", "almacenamiento", "espacio"]):
                raw_out = get_quick_sys_metrics()
            else:
                try:
                    raw_out = subprocess.check_output(
                        inspect_cmd,
                        shell=True,
                        timeout=3,
                        stderr=subprocess.STDOUT
                    ).decode("utf-8", errors="ignore")
                except Exception as e:
                    raw_out = f"Error: {e}"
            
            summary_prompt = [
                {"role": "system", "content": (
                    "Eres un asistente de terminal para un desarrollador. "
                    "REGLAS DE FORMATO ESTRICTAS: "
                    "1. CERO EMOJIS. No uses absolutamente ningún emoji. "
                    "2. CERO ASTERISCOS ni formato markdown crudo (no uses **negrita** ni `código`). "
                    "3. Texto plano, sobrio, limpio, sin ruido visual, estilo terminal Unix minimalista. "
                    "4. Si la pregunta es sobre memoria/almacenamiento: "
                    "muestra RAM y Disco de forma limpia en 2 líneas: "
                    "RAM: X GB libres de Y GB (Z GB en uso)\n"
                    "Disco: X GB libres de Y GB "
                    "5. Si la pregunta es sobre CPU: "
                    "muestra el consumo y los 2-3 procesos más activos en 1 sola línea limpia: "
                    "CPU: X% en uso (top: proc1 Y%, proc2 Z%) "
                    "6. Sé breve, funcional y sin introducciones."
                )},
                {"role": "user", "content": f"Pregunta: {clean_query}\nDatos reales del sistema:\n{raw_out[:2000]}"}
            ]
            answer = call_api(summary_prompt, max_tokens=180, temperature=0.1)
            answer = re.sub(r'[*`_#]', '', answer).strip()
            print(f"INFO:{answer}")
            return
            
        else:
            if " " in clean_query:
                ans = call_api([
                    {"role": "system", "content": "Responde de forma fría, analítica y directa en 1 sola línea sin formato markdown ni emojis."},
                    {"role": "user", "content": clean_query}
                ], max_tokens=100)
                ans = re.sub(r'[*`_#]', '', ans).strip()
                append_history(clean_query, f"Answer: {ans}")
                print(f"INFO:{ans}")
                return
            print("NONE")
            return
            
    except Exception:
        try:
            fallback = call_api([
                {"role": "system", "content": "You are a shell command translator. Output ONLY the raw executable shell command. No markdown, no commentary."},
                {"role": "user", "content": clean_query}
            ], max_tokens=150)
            if fallback and not fallback.startswith("```"):
                print(f"ACTION:{fallback.strip()}")
            else:
                print("NONE")
        except Exception:
            print("NONE")

def stream_chat(prompt):
    is_local = any(h in CONFIG["api_url"] for h in ["localhost", "127.0.0.1", "0.0.0.0"])
    if not CONFIG["api_key"] and not is_local:
        print("  ✗ Configura tu API key en ~/.config/pudding/config.json o con export PUDDING_API_KEY=...")
        return

    payload = {
        "model": CONFIG["model"],
        "messages": [
            {"role": "system", "content": "You are a helpful expert Unix/macOS and cybersecurity terminal assistant. Provide concise, clean text answers without emoji spam."},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.3,
        "stream": True
    }
    headers = {
        "Content-Type": "application/json",
        "User-Agent": "pudding/1.0"
    }
    if CONFIG["api_key"]:
        headers["Authorization"] = f"Bearer {CONFIG['api_key']}"

    req = urllib.request.Request(
        CONFIG["api_url"],
        data=json.dumps(payload).encode("utf-8"),
        headers=headers
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            for line in r:
                line = line.decode("utf-8", errors="ignore").strip()
                if line.startswith("data: ") and line != "data: [DONE]":
                    try:
                        chunk = json.loads(line[6:])
                        delta = chunk["choices"][0]["delta"].get("content")
                        if delta:
                            print(delta, end="", flush=True)
                    except Exception:
                        pass
        print()
    except Exception as e:
        print(f"\n  ✗ Error: {e}")

def interactive_chat():
    print(f"\033[1;37mpudding interactive chat ({CONFIG['model']})\033[0m (escribe 'exit' para salir)\n")
    history = [{"role": "system", "content": "You are a helpful expert Unix and cybersecurity terminal assistant. Keep responses clean and noise-free."}]
    
    headers = {
        "Content-Type": "application/json",
        "User-Agent": "pudding/1.0"
    }
    if CONFIG["api_key"]:
        headers["Authorization"] = f"Bearer {CONFIG['api_key']}"

    while True:
        try:
            user_input = input("\033[1;37m› \033[0m").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit", "salir"]:
                break
            
            history.append({"role": "user", "content": user_input})
            payload = {
                "model": CONFIG["model"],
                "messages": history,
                "temperature": 0.3,
                "stream": True
            }
            req = urllib.request.Request(
                CONFIG["api_url"],
                data=json.dumps(payload).encode("utf-8"),
                headers=headers
            )
            full_reply = []
            with urllib.request.urlopen(req, timeout=15) as r:
                for line in r:
                    line = line.decode("utf-8", errors="ignore").strip()
                    if line.startswith("data: ") and line != "data: [DONE]":
                        try:
                            chunk = json.loads(line[6:])
                            delta = chunk["choices"][0]["delta"].get("content")
                            if delta:
                                print(delta, end="", flush=True)
                                full_reply.append(delta)
                        except Exception:
                            pass
            print("\n")
            history.append({"role": "assistant", "content": "".join(full_reply)})
        except (KeyboardInterrupt, EOFError):
            print("\n")
            break

def main():
    if len(sys.argv) < 2:
        interactive_chat()
        return

    first = sys.argv[1]
    if first in ["--chat", "-c"]:
        if len(sys.argv) > 2:
            stream_chat(" ".join(sys.argv[2:]))
        else:
            interactive_chat()
    elif first in ["--version", "-v"]:
        print("pudding v1.0.0 (Clean Natural Language Terminal Bridge)")
    elif first in ["--config"]:
        print(json.dumps(CONFIG, indent=2))
    else:
        query = " ".join(sys.argv[1:])
        handle_query(query)

if __name__ == "__main__":
    main()
