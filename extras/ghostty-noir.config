# ═══════════════════════════════════════════════════
#  Ghostty — Noir Monochrome Configuration
#  Black & White developer aesthetic with full window functionality
# ═══════════════════════════════════════════════════

# --- Typography ---
font-family = FiraCode Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 6

# --- Palette: Pure Noir ---
theme =
background = #09090b
foreground = #a1a1aa

cursor-color = #d4d4d8
cursor-style = bar
cursor-style-blink = true
cursor-text = #09090b

selection-background = #27272a
selection-foreground = #e4e4e7

# --- ANSI Grayscale Palette ---
palette = 0=#18181b
palette = 8=#3f3f46
palette = 1=#71717a
palette = 9=#a1a1aa
palette = 2=#a1a1aa
palette = 10=#d4d4d8
palette = 3=#8a8a8f
palette = 11=#b4b4bc
palette = 4=#6b6b76
palette = 12=#9898a4
palette = 5=#78788a
palette = 13=#a8a8b8
palette = 6=#8c8c9a
palette = 14=#bababf
palette = 7=#d4d4d8
palette = 15=#e4e4e7

# --- Window Layout ---
macos-titlebar-style = transparent
maximize = true
title = " "
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
macos-option-as-alt = true

# --- Background blur ---
background-opacity = 0.94
background-blur-radius = 30
unfocused-split-opacity = 0.80

window-padding-color = extend
resize-overlay = never
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Keybindings ---
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom
keybind = super+w=close_surface
keybind = super+enter=toggle_fullscreen
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+n=new_window
keybind = super+alt+left=resize_split:left,20
keybind = super+alt+right=resize_split:right,20
keybind = super+alt+up=resize_split:up,20
keybind = super+alt+down=resize_split:down,20

auto-update = check
