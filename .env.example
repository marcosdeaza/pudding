# ═════════════════════════════════════════════════════════════════════
#  pudding — Environment Configuration Examples
#  Copy or export these variables in your ~/.zshrc or ~/.bashrc
# ═════════════════════════════════════════════════════════════════════

# ---------------------------------------------------------------------
# Option 1: DeepSeek (Recommended: Ultra-fast, smart & affordable)
# ---------------------------------------------------------------------
export PUDDING_API_BASE="https://api.deepseek.com/v1/chat/completions"
export PUDDING_MODEL="deepseek-chat"
export PUDDING_API_KEY="sk-tu-api-key-de-deepseek"

# ---------------------------------------------------------------------
# Option 2: OpenAI / ChatGPT (gpt-4o, gpt-4o-mini)
# ---------------------------------------------------------------------
# export PUDDING_API_BASE="https://api.openai.com/v1/chat/completions"
# export PUDDING_MODEL="gpt-4o-mini"
# export PUDDING_API_KEY="sk-proj-tu-api-key-de-openai"

# ---------------------------------------------------------------------
# Option 3: Ollama Local (100% Free, Offline, 0 Data Sent to Cloud)
# ---------------------------------------------------------------------
# export PUDDING_API_BASE="http://localhost:11434/v1/chat/completions"
# export PUDDING_MODEL="llama3.2:3b"
# export PUDDING_API_KEY="ollama-local"

# ---------------------------------------------------------------------
# Option 4: Groq (Ultra-fast inference)
# ---------------------------------------------------------------------
# export PUDDING_API_BASE="https://api.groq.com/openai/v1/chat/completions"
# export PUDDING_MODEL="llama-3.3-70b-versatile"
# export PUDDING_API_KEY="gsk_tu-api-key-de-groq"
